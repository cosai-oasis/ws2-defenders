<https://www.commoncoreontologies.org/ont00001768> a owl:DatatypeProperty ;
    rdfs:label "has URI value"@en ;
    skos:definition "A data property that has as its range a URI value."@en .

<https://www.commoncoreontologies.org/ont00001787> a owl:ObjectProperty ;
    rdfs:label "agent in"@en ;
    skos:definition "x agent_in y iff y is an instance of Process and x is an instance of Agent, such that x is causally active in y."@en .

<https://www.commoncoreontologies.org/ont00001808> a owl:ObjectProperty ;
    rdfs:label "is about"@en ;
    skos:definition "x is_about y is a primitive relationship between an instance of Information Content Entity x and an instance of Entity y."@en .

<https://www.commoncoreontologies.org/ont00001816> a owl:ObjectProperty ;
    rdfs:label "is output of"@en ;
    skos:definition "x is output of y =Def x participates in y, x is an Independent Continuant (but not a Spatial Region), y is a Process, and the presence of x at the end of y is a necessary condition for the completion of y."@en .

<https://www.commoncoreontologies.org/ont00001833> a owl:ObjectProperty ;
    rdfs:label "has agent"@en ;
    skos:definition "x has agent y =Def y agent in x."@en .

<https://www.commoncoreontologies.org/ont00001869> a owl:ObjectProperty ;
    rdfs:label "interval during"@en ;
    skos:definition "x interval_during y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant u, v, w, and z such that u is the starting instant of x, v is the ending instant of x, w is the starting instant of y, z is the ending instant of y, w is before u, and v is before z."@en .

<https://www.commoncoreontologies.org/ont00001879> a owl:ObjectProperty ;
    rdfs:label "designated by"@en ;
    skos:definition "x designated by y =Def y designates x."@en .

<https://www.commoncoreontologies.org/ont00001916> a owl:ObjectProperty ;
    rdfs:label "designates"@en ;
    skos:definition "x designates y iff x is an instance of a Designative Information Content Entity, and y is an instance of an Entity, such that given some context, x uniquely distinguishes y from other entities."@en .

<https://www.commoncoreontologies.org/ont00001918> a owl:ObjectProperty ;
    rdfs:label "occurs at"@en ;
    skos:definition "x occurs_at y iff x is an instance of Process and y is an instance of Site, such that x occurs in y."@en .

<https://www.commoncoreontologies.org/ont00001939> a owl:ObjectProperty ;
    rdfs:label "is affiliated with"@en ;
    skos:definition "x is_affiliated_with y iff x and y are instances of Agent, such that they have any kind of social or business relationship."@en .

<https://www.commoncoreontologies.org/ont00001940> a owl:ObjectProperty ;
    rdfs:label "interval is before"@en ;
    skos:definition "x interval_is_before y iff x and y are both instances of Temporal Interval and there exist instances of Temporal Instant w, z such that w is the ending instant of x and z is the starting instant of y and w is before z."@en .

<https://www.commoncoreontologies.org/ont00001986> a owl:ObjectProperty ;
    rdfs:label "has output"@en ;
    skos:definition "x has output y =Def y is output of x."@en .

<https://www.commoncoreontologies.org/ont00001992> a owl:ObjectProperty ;
    rdfs:label "has organizational context"@en ;
    skos:definition "x has organizational context y =Def y is organizational context of x."@en .

